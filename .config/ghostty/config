# custom-shader = /home/taj/.config/ghostty/shaders/NEW/cursor_sweep.glsl
shell-integration-features = sudo

# {{{ THEMING

theme = GruvboxDarkHard
# background=#1d2021

# }}}

# {{{ FONT

font-size = 11
font-family = MonoLisa
# font-family = Rumiko Sans Demo
# font-family = IosevkaTerm Nerd Font
# font-family = JetBrainsMono Nerd Font
# font-family = IosevkaTerm Nerd Font

# }}}

# {{{ BEHAVIOUR

confirm-close-surface = false
# mouse-hide-while-typing = true
copy-on-select = false
# shell-integration-features = no-cursor,sudo

# }}}

# {{{ KEYBINDINGS

keybind = ctrl+shift+r=reload_config

# Split creation
keybind = alt+v=new_split:right
keybind = alt+s=new_split:down

# Split navigation
# keybind = ctrl+tab=goto_split:next
# keybind = ctrl+shift+tab=goto_split:previous
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Split sizing
keybind = ctrl+left=resize_split:left,30
keybind = ctrl+right=resize_split:right,30
keybind = ctrl+up=resize_split:up,30
keybind = ctrl+down=resize_split:down,30
keybind = ctrl+shift+equal=equalize_splits

# }}}

# {{{ MISC

# cursor-style = bar
# background-opacity = 0.98
# background-blur-radius = 20

font-thicken = true
window-decoration = true
window-height = 32
window-width = 180
window-theme = ghostty
cursor-style-blink = false

window-padding-x = 10
window-padding-y = 10

adjust-cell-width = -12%
adjust-cell-height = 8
# class = ghostty
# x11-instance-name = popup
shell-integration = fish
shell-integration-features = no-cursor
